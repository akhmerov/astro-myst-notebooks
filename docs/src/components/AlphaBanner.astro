---
import Banner from '@astrojs/starlight/components/Banner.astro';
---

<aside class="alpha-banner" aria-label="Project status" data-pagefind-ignore>
  <strong>Alpha</strong> — Experimental software. APIs and behavior may change.
</aside>
<Banner />

<style>
  .alpha-banner {
    padding: 0.65rem var(--sl-nav-pad-x);
    background: var(--sl-color-orange-low);
    color: var(--sl-color-orange-high);
    border-bottom: 1px solid var(--sl-color-orange);
    font-size: var(--sl-text-sm);
    text-align: center;
    text-wrap: balance;
  }

  strong {
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
</style>
